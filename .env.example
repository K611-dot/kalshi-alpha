# Kalshi API credentials. NEVER commit the real values or the .pem file.
# Create an API key at https://kalshi.com/account/profile -> API Keys
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# "prod" or "demo". Demo is the sandbox environment.
KALSHI_ENV=demo

# Engine behaviour
KALSHI_ALPHA_MODE=offline          # offline | live
KALSHI_ALPHA_LOG_LEVEL=INFO
KALSHI_ALPHA_DATA_DIR=./data
